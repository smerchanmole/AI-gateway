# Copia este fichero como `.env`; nunca pegues secretos en config.yaml.
# Salida hacia OpenAI: sólo la usan modelos `openai/...` que la referencien.
OPENAI_API_KEY=sk-tu-clave-aqui
# Puertos compatibles con Cloudera AI Workbench; en local se usan estos defaults.
# CDSW_APP_PORT=8081
# CDSW_READONLY_PORT=8090
# Entrada al gateway: la usan el panel y las aplicaciones cliente.
LITELLM_MASTER_KEY=genera-una-clave-larga-y-aleatoria

# Las credenciales Cloudera se introducen desde su formulario y se guardan con
# permisos 0600 en runtime/cloudera-connections.json; no hace falta ponerlas aquí.
