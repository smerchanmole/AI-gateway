# Copia este fichero como `.env`; nunca pegues secretos en config.yaml.
# Salida hacia OpenAI: sólo la usan modelos `openai/...` que la referencien.
OPENAI_API_KEY=sk-tu-clave-aqui
# Un solo puerto exterior. Cloudera lo inyecta; local usa 8090.
# IA_GATEWAY_PORT=8090
# Los dos upstreams sólo son visibles por loopback.
# IA_GATEWAY_LITELLM_PORT=14000
# IA_GATEWAY_DASHBOARD_PORT=18080
# Las credenciales Cloudera se introducen desde su formulario y se guardan con
# permisos 0600 en runtime/cloudera.sqlite3; no hace falta ponerlas aquí.
# Tiempo máximo del CDP CLI al generar/renovar el token (10-300 segundos).
# CDP_RENEWAL_TIMEOUT_SECONDS=60
# Antelación máxima de renovación. Se limita al 25% de la vida del token
# para no regenerar continuamente JWT cortos (por defecto, hasta 7 días).
# CDP_RENEWAL_LEAD_SECONDS=604800
